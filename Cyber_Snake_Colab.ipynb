    "# 🐍 CYBER SNAKE 3000 - Jogo por Gestos via Webcam\n",
    "### Elaborado por **Lucas Martins** (lucaslmf@gmail.com)\n",
    "- 💼 **LinkedIn**: [linkedin.com/in/lucaslmf](https://www.linkedin.com/in/lucaslmf)\n",
    "- 📸 **Instagram**: [@lucaslmf_](https://www.instagram.com/lucaslmf_/)\n",
    "\n",
    "--- \n",
    "### 🚀 Como jogar no Google Colab:\n",
    "1. Execute a célula abaixo clicando no botão **Play** ▶️ (ou pressione `Shift + Enter`).\n",
    "2. Quando o navegador pedir permissão para acessar a **Webcam**, clique em **Permitir**.\n",
    "3. Posicione a sua mão na frente da câmera. A cobrinha seguirá a ponta do seu dedo indicador em tempo real!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from IPython.display import HTML, display\n",
    "\n",
    "# Executa o jogo Cyber Snake interativo diretamente na célula do Google Colab\n",
    "colab_game_html = \"\"\"\n",
    "<!DOCTYPE html>\n",
    "<html lang=\"pt-BR\">\n",
    "<head>\n",
    "  <meta charset=\"UTF-8\">\n",
    "  <style>\n",
    "    body { background: #070913; color: #f0f4ff; font-family: sans-serif; text-align: center; margin: 0; padding: 10px; }\n",
    "    h1 { color: #00f3ff; text-shadow: 0 0 10px #00f3ff; margin-bottom: 5px; font-size: 24px; }\n",
    "    p { margin: 5px 0 15px 0; color: #8a99b5; font-size: 14px; }\n",
    "    iframe { border: 2px solid #00f3ff; border-radius: 12px; box-shadow: 0 0 20px rgba(0, 243, 255, 0.4); width: 100%; height: 720px; }\n",
    "  </style>\n",
    "</head>\n",
    "<body>\n",
    "  <h1>🐍 CYBER SNAKE 3000</h1>\n",
    "  <p>Elaborado por <strong>Lucas Martins</strong> | ✉️ lucaslmf@gmail.com</p>\n",
    "  <div id=\"game-container\"></div>\n",
    "\n",
    "  <script>\n",
    "    const iframe = document.createElement('iframe');\n",
    "    iframe.srcdoc = `\n",
    "      <!DOCTYPE html>\n",
    "      <html>\n",
    "      <head>\n",
    "        <script src=\"https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js\"></script>\n",
    "        <script src=\"https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js\"></script>\n",
    "        <style>\n",
    "          body { background: #0b0f19; color: #fff; font-family: monospace; text-align: center; margin: 0; padding-top: 10px; overflow: hidden; }\n",
    "          #canvas { background: #070913; border: 2px solid #00f3ff; border-radius: 8px; box-shadow: 0 0 15px #00f3ff; }\n",
    "          #video { display: none; }\n",
    "          .header-info { color: #00ff66; margin-bottom: 8px; font-size: 14px; text-shadow: 0 0 5px #00ff66; }\n",
    "          .credits { color: #ff007f; font-size: 12px; margin-top: 5px; }\n",
    "        </style>\n",
    "      </head>\n",
    "      <body>\n",
    "        <div class=\"header-info\">🖐️ Mova a ponta do dedo indicador para guiar a cobra</div>\n",
    "        <video id=\"video\" playsinline></video>\n",
    "        <canvas id=\"canvas\" width=\"760\" height=\"520\"></canvas>\n",
    "        <div class=\"credits\">Elaborado por Lucas Martins | lucaslmf@gmail.com</div>\n",
    "\n",
    "        <script>\n",
    "          const video = document.getElementById('video');\n",
    "          const canvas = document.getElementById('canvas');\n",
    "          const ctx = canvas.getContext('2d');\n",
    "\n",
    "          let snake = [{x: 380, y: 260}];\n",
    "          let food = {x: 200, y: 200};\n",
    "          let score = 0;\n",
    "          let targetX = 380, targetY = 260;\n",
    "\n",
    "          function spawnFood() {\n",
    "            food.x = Math.floor(Math.random() * 36 + 1) * 20;\n",
    "            food.y = Math.floor(Math.random() * 24 + 1) * 20;\n",
    "          }\n",
    "\n",
    "          const hands = new Hands({\n",
    "            locateFile: (file) => \\`https://cdn.jsdelivr.net/npm/@mediapipe/hands/\\\${file}\\`\n",
    "          });\n",
    "          hands.setOptions({ maxNumHands: 1, modelComplexity: 1, minDetectionConfidence: 0.5 });\n",
    "          hands.onResults((results) => {\n",
    "            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {\n",
    "              const lm = results.multiHandLandmarks[0][8];\n",
    "              targetX = (1 - lm.x) * canvas.width;\n",
    "              targetY = lm.y * canvas.height;\n",
    "            }\n",
    "          });\n",
    "\n",
    "          const camera = new Camera(video, {\n",
    "            onFrame: async () => { await hands.send({image: video}); },\n",
    "            width: 640, height: 480\n",
    "          });\n",
    "          camera.start();\n",
    "\n",
    "          function gameLoop() {\n",
    "            let head = {...snake[0]};\n",
    "            let dx = targetX - head.x;\n",
    "            let dy = targetY - head.y;\n",
    "            let dist = Math.hypot(dx, dy);\n",
    "            if (dist > 4) {\n",
    "              head.x += (dx / dist) * 7;\n",
    "              head.y += (dy / dist) * 7;\n",
    "            }\n",
    "            snake.unshift(head);\n",
    "\n",
    "            if (Math.hypot(head.x - food.x, head.y - food.y) < 22) {\n",
    "              score += 10;\n",
    "              spawnFood();\n",
    "            } else {\n",
    "              snake.pop();\n",
    "            }\n",
    "\n",
    "            ctx.fillStyle = '#070913';\n",
    "            ctx.fillRect(0, 0, canvas.width, canvas.height);\n",
    "\n",
    "            // Desenhar comida\n",
    "            ctx.fillStyle = '#00ff66';\n",
    "            ctx.shadowBlur = 12; ctx.shadowColor = '#00ff66';\n",
    "            ctx.beginPath(); ctx.arc(food.x, food.y, 9, 0, Math.PI * 2); ctx.fill();\n",
    "\n",
    "            // Desenhar cobra\n",
    "            ctx.fillStyle = '#00f3ff';\n",
    "            ctx.shadowBlur = 10; ctx.shadowColor = '#00f3ff';\n",
    "            snake.forEach((p, index) => {\n",
    "              ctx.beginPath();\n",
    "              ctx.arc(p.x, p.y, index === 0 ? 12 : 10, 0, Math.PI * 2);\n",
    "              ctx.fill();\n",
    "            });\n",
    "\n",
    "            // Alvo do Dedo\n",
    "            ctx.strokeStyle = '#ff007f'; ctx.lineWidth = 2;\n",
    "            ctx.beginPath(); ctx.arc(targetX, targetY, 14, 0, Math.PI * 2); ctx.stroke();\n",
    "\n",
    "            // Placar\n",
    "            ctx.shadowBlur = 0; ctx.fillStyle = '#ffffff'; ctx.font = 'bold 18px monospace';\n",
    "            ctx.fillText('PONTUAÇÃO: ' + score, 25, 35);\n",
    "\n",
    "            requestAnimationFrame(gameLoop);\n",
    "          }\n",
    "          gameLoop();\n",
    "        </script>\n",
    "      </body>\n",
    "      </html>\n",
    "    `;\n",
    "    document.getElementById('game-container').appendChild(iframe);\n",
    "  </script>\n",
    "</body>\n",
    "</html>\n",
    "\"\"\"\n",
    "\n",
    "display(HTML(colab_game_html))"
   ]
  }
 ],
